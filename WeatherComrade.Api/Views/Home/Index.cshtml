@model WeatherComrade.Api.Models.HomeViewModel
@{
    ViewData["Title"] = "WeatherComrade";

    var groupedForecasts =
        Model.ForecastData?.List
            .GroupBy(f =>
                DateTime.Parse(f.DateText).Date)
            .Take(5)
            .ToList();

    var labels =
       groupedForecasts?
           .Select(g => g.Key.ToString("ddd"))
           .ToList();

    var temperatures =
        groupedForecasts?
            .Select(g => g.Average(x => x.Main.Temp))
            .ToList();
}

<div class="weather-page" data-weather-condition="@Model.WeatherData?.Weather[0].Main">

    <div class="weather-section">
        @if (Model.WeatherData != null)
        {
            <div class="weather-card">

                <h1 class="city-name">
                    @Model.WeatherData.Name
                </h1>

                <img class="weather-icon"
                     src="https://openweathermap.org/img/wn/@(Model.WeatherData.Weather[0].Icon)@@2x.png" />

                <h2 class="temperature">
                    @Model.WeatherData.Main.Temp°C
                </h2>

                <p class="weather-description">
                    @Model.WeatherData.Weather[0].Description
                </p>

            </div>
        }
        @if (Model.Companion != null)
        {
            <div class="companion-card">

                <img class="companion-image" src="@Model.Companion.Image" />

                <h3 class="recommendation-text">
                    @Model.Companion.Recommendation
                </h3>

            </div>
        }

    </div>
    @if (groupedForecasts != null)
    {
        <div class="forecast-section">

            <h2 class="section-title">
                5-Day Forecast
            </h2>
            <div class="forecast-tabs">

                @for (int i = 0; i < groupedForecasts.Count; i++)
                {
                    var day = groupedForecasts[i];

                    <button class="forecast-tab @(i == 0 ? "active-tab" : "")" data-day="day-@i">

                        @day.Key.ToString("ddd")

                    </button>
                }

            </div>

            @for (int i = 0; i < groupedForecasts.Count; i++)
            {
                var day = groupedForecasts[i];

                <div class="forecast-day-content @(i == 0 ? "active-day" : "")" id="day-@i">

                    <h3>
                        @day.Key.ToString("dddd")
                    </h3>

                    <div class="hourly-forecast-list">

                        @foreach (var item in day)
                        {
                            <div class="hourly-item">

                                <p>
                                    @DateTime.Parse(item.DateText).ToString("HH:mm")
                                </p>

                                <img src="https://openweathermap.org/img/wn/@(item.Weather[0].Icon)@@2x.png" width="50" />

                                <p>
                                    @item.Main.Temp°C
                                </p>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }
    <div class="chart-section">

        <h2 class="section-title">
            Temperature Trend
        </h2>

        <canvas id="temperatureChart" data-labels='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels))'
                data-temperatures='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(temperatures))'>
        </canvas>

    </div>

</div>